# Database (PostgreSQL)
# For local development with docker-compose, set your connection string:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# For testing (optional separate database):
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_test"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Data Backend: 'mock' or 'profit4'
DATA_BACKEND="mock"

# Seed Token (required for /api/admin/seed endpoint)
# Generate with: openssl rand -base64 32
SEED_TOKEN=""

# Profit4 GraphQL
PROFIT4_GRAPHQL_URL="https://abco.profit4.co.uk/api/graphql"
PROFIT4_API_KEY=""
